#!/usr/bin/env python3.15
"""park — validate the briefs tree, compile the TODO.md index, take intake.

    bin/park validate            validate every brief under briefs/
    bin/park map                 validate, then regenerate TODO.md's
                                 generated region in place
    bin/park map --check         validate and compare; non-zero when the
                                 region on disk disagrees with the briefs
    bin/park intake list         every deposit in briefs/inbox/, and each
                                 file there that is not one
    bin/park intake deposit ID   create briefs/inbox/ID.md from stdin
                                 (or --file); create-only
    bin/park intake promote ID   deposit -> briefs/ID.md, map regenerated,
                                 deposit removed: all of it, or nothing
    bin/park intake reject ID --reason TEXT
                                 delete the deposit, print one record line
    bin/park intake github       open issues -> deposits (reads the forge)
    bin/park intake github --outbound --repo R [--apply]
                                 plan (or, with --apply, make) the closes
                                 of R's issues whose brief is done

The GitHub code is frozen (Osama, 2026-11-04): it keeps working and takes no new
features. One known flaw stays with it: `github_records` reads a quoted
`status: "done"` as unsettled, so the import reads that brief's issue from the
forge where it need not.

Exit 0 clean; 1 on a refusal (validation, drift, intake, a failed write); 2
on usage. Every refusal line opens with a stable code, `PARK-Ennn` — CODES
below, and the README's table, which a test holds to it.

The repository root is the nearest directory at or above the working
directory that carries `briefs/` — resolved from where park is RUN, never
from where it is installed, so a copy on PATH or a `uvx` install works on
whatever repository you are standing in.

The schema: frontmatter carrying exactly the fields id / type /
status / owner / gate / triggers / deferrals / brief, with closed
vocabularies, and gates expressed as brief ids rather than prose (the one
prose form is "manual: <checkable fact>", which is unresolvable by design
and treated as such). `deferrals` names, as a list of ids, any prior
decision this brief is the live destination for — the durable, structural
answer to "where did that deferred item go" that used to be answered by
scanning prose for a checkbox next to the id (brief
deferral-guard-resolves-structurally). The parser accepts precisely this
grammar — plain scalars, inline `[a, b]` lists, block `- item` lists — and
refuses anything else naming the offending field. It is not YAML: a value may
hold a second colon, which a YAML parser refuses. Standard library only, so
the tool is one file with no dependencies.

Two semantic checks follow from treating blockers and destinations as ids
rather than prose. First, the reason gates are ids: a `parked` brief whose
gates ALL resolve to done/superseded briefs is reported as gate-opened —
work that is unblocked while still filed as blocked, which is invisible in
any format whose blockers are sentences. A `manual:` gate blocks that
conclusion, and an empty gate list is parked-on-nothing, which is legal (an
undated park), not opened. Second, the reason deferrals are ids: the same
id claimed by two briefs' `deferrals` is an ambiguous destination — a
question a prose scan could not even ask, since two documents can both
mention the same words. An empty deferrals list is the common case (a
brief that resolves nothing); every non-empty entry must be unique across
the whole tree.

The index's generated region runs from the top of the file to the END
marker; anything below the marker is preserved untouched, which is what
lets a migration run in batches with both systems true at every step.
Once nothing is left below the marker, the whole file is generated.
"""

import argparse
import contextlib
import datetime
import errno
import hashlib
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import unicodedata
from pathlib import Path
from typing import NamedTuple

try:
    import fcntl
except ImportError:     # Windows: no lock; writes stay atomic
    fcntl = None

# Declared from the first commit rather than added at publication: the sibling
# review tool shipped two releases whose `--version` could not tell them apart,
# because the constant arrived after the second one. A version is cheap before
# anyone installs it and a behaviour change afterwards.
#
# The rule this constant lives under: the version is a human judgment, bumped
# deliberately inside the change that will be published — never derived
# mechanically from commit types — and --version must discriminate any two
# published trees.
PARK_VERSION = "0.4.4"

def find_root() -> Path:
    """The nearest ancestor (working directory upward) carrying `briefs/`.

    Resolved from the working directory, not the script's location: a park
    installed on PATH or run through `uvx` sits nowhere near the repository
    it is asked about. Falls back to the working directory itself, so the
    missing-briefs refusal names the place park actually looked. When the
    working directory itself is gone (deleted under the shell), the answer
    is the relative `Path()`, which `main` refuses (E101) before any verb
    reads it, so `--version` still answers (the 2026-11-04 review: every
    verb, `--version` included, tracebacked here).
    """
    try:
        cwd = Path.cwd().resolve()
    except OSError:
        return Path()
    for candidate in (cwd, *cwd.parents):
        if (candidate / "briefs").is_dir():
            return candidate
    return cwd


ROOT = find_root()
BRIEFS = ROOT / "briefs"
TODO = ROOT / "TODO.md"

TYPES = {"task", "decision", "watch", "record", "procedure"}
STATUSES = {"open", "parked", "done", "superseded"}
OWNERS = {"user", "agent"}
FIELDS = ("id", "type", "status", "owner", "gate", "triggers", "deferrals",
          "brief")
LIST_FIELDS = {"gate", "triggers", "deferrals"}
# Fields a brief may omit, and what omission means. `deferrals` arrived in
# 0.3.0; making it required would break every 0.2.x tree on upgrade for a
# field whose common value is empty. Absent reads as "this brief is nobody's
# deferral destination", which is exactly what `[]` says.
OPTIONAL_DEFAULTS = {"deferrals": ()}
END_MARK = "<!-- END GENERATED park map -->"
INBOX = BRIEFS / "inbox"

# Stable refusal codes (0.4.0). Every refusal line opens with one, so tests,
# documentation and an adopter's allowlist can name the refusal rather than
# its prose, and a message can be reworded without breaking any of them. A
# code is never reused for a different refusal. `public-park/README.md`
# carries the same table, held to this one by a test.
CODES = {
    "PARK-E001": "usage: an unknown verb, flag or combination",
    "PARK-E101": "`briefs/` does not exist at or above the working directory, "
                 "or that directory itself is gone",
    "PARK-E102": "a brief cannot be read as UTF-8 text",
    "PARK-E103": "a brief has no frontmatter (its first line is not `---`)",
    "PARK-E104": "a brief's frontmatter is never closed with `---`",
    "PARK-E105": "a frontmatter line is not `key: value`",
    "PARK-E106": "an unknown frontmatter field",
    "PARK-E107": "a duplicate frontmatter field",
    "PARK-E108": "a list item outside a list field",
    "PARK-E109": "an empty list item",
    "PARK-E110": "a list field that is not a list",
    "PARK-E111": "a required field is missing",
    "PARK-E112": "the id does not match the filename stem",
    # PARK-E113, a duplicate id, could never fire: an id is its file's stem,
    # and no two files share one. It went in 0.4.4 and is never reused.
    "PARK-E114": "`briefs/` cannot be listed",
    "PARK-E120": "`type` outside its vocabulary",
    "PARK-E121": "`status` outside its vocabulary",
    "PARK-E122": "`owner` outside its vocabulary",
    "PARK-E123": "the `brief` line is empty",
    "PARK-E124": "a watch whose status is not open",
    "PARK-E125": "a watch without a trigger",
    "PARK-E126": "a provenance line whose `github:` origin is not "
                 "`github:[HOST/]OWNER/NAME#N`",
    "PARK-E127": "a `brief` line or gate carrying the index's end marker",
    "PARK-E128": "an id holding a character other than a letter, digit, `.`, "
                 "`_` or `-`, which the index's link to it cannot carry",
    "PARK-E130": "a `manual:` gate carrying no checkable fact",
    "PARK-E131": "a gate that references its own brief",
    "PARK-E132": "a gate that resolves to no brief",
    "PARK-E133": "parked, but every gate has closed: the gate has opened",
    "PARK-E134": "one deferral id claimed by more than one brief",
    "PARK-E135": "live briefs whose gates wait on each other in a cycle",
    "PARK-E140": "`TODO.md` carries no generated region (`map --check`)",
    "PARK-E141": "`TODO.md` is stale against the briefs (`map --check`)",
    "PARK-E142": "`TODO.md` cannot be read as UTF-8 text",
    "PARK-E143": "`TODO.md` cannot be written (`map`)",
    "PARK-E144": "`TODO.md` carries more than one end marker, so what is "
                 "generated cannot be told from what is yours",
    "PARK-E201": "a deposit id that is not a lowercase kebab slug",
    "PARK-E202": "no such deposit in `briefs/inbox/` (the queue's README, "
                 "in any spelling, is none)",
    "PARK-E203": "the deposit already exists (deposits are create-only)",
    "PARK-E204": "a brief with that id already exists",
    "PARK-E205": "a deposit that is empty or not UTF-8 text",
    "PARK-E206": "line 1 is not a provenance line",
    "PARK-E207": "an origin outside the closed vocabulary",
    "PARK-E208": "the provenance line declares no origin",
    "PARK-E209": "`--origin` given for a line that already declares one",
    "PARK-E210": "line 2, the map line, is missing or blank",
    "PARK-E211": "a scaffolded value is blank, multi-line, padded, or does "
                 "not read back as itself",
    "PARK-E212": "a rejection reason that is blank or not one line",
    "PARK-E213": "that GitHub origin is already deposited or promoted",
    "PARK-E214": "a write failed; every file was restored, or the ones "
                 "that could not be are named",
    "PARK-E215": "promotion refused: the tree would not validate",
    "PARK-E216": "a deposit id reserved for the queue's README, in any "
                 "letter case",
    "PARK-E217": "an intake input cannot be read: the `--file` or stdin "
                 "text, a deposit, or the `briefs/inbox/` listing",
    "PARK-E218": "a `github#N` origin, the 0.4.0 form, names no repository: "
                 "write it as `github:OWNER/NAME#N`",
    # PARK-E219 went with `--bind` in 0.4.4 and is never reused.
    "PARK-E301": "`gh` is not on PATH",
    "PARK-E302": "`gh` failed or timed out",
    "PARK-E303": "`gh` answered something other than the expected JSON",
    "PARK-E304": "an issue's deposit ids are held: one by a file recording "
                 "no other issue's origin (it may be that issue's), or all "
                 "three by other issues",
    "PARK-E305": "an outbound close failed; the ones before it were made",
}


def write_atomic(path: Path, data: bytes) -> None:
    """Replace `path` whole: a reader gets the old bytes or the new ones. A
    file the user may not write stays refused, as opening it would be."""
    target = Path(os.path.realpath(path))
    try:
        mode = stat.S_IMODE(os.stat(target).st_mode)
    except FileNotFoundError:
        mode = None
    if mode is not None and not os.access(target, os.W_OK):
        raise PermissionError(errno.EACCES, os.strerror(errno.EACCES),
                              str(path))
    if mode is None:
        mask = os.umask(0)
        os.umask(mask)
        mode = 0o666 & ~mask
    fd, scratch = tempfile.mkstemp(prefix=f".{target.name}.",
                                   dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(scratch, mode)
        os.replace(scratch, target)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(scratch)
        raise


@contextlib.contextmanager
def tree_lock(shared: bool = False):
    """Hold `briefs/` itself, not a lock file, so nothing appears in the tree
    and a killed holder releases it. Where it cannot be held (no flock, or
    `briefs/` cannot be opened, which the verb then refuses itself) the verb
    runs unlocked."""
    fd = None
    with contextlib.suppress(OSError):
        fd = os.open(BRIEFS, os.O_RDONLY)
        if fcntl is not None:
            fcntl.flock(fd, fcntl.LOCK_SH if shared else fcntl.LOCK_EX)
    try:
        yield
    finally:
        if fd is not None:
            os.close(fd)


#: What `uninterrupted` holds: the signals that end a run by default.
INTERRUPTS = tuple(getattr(signal, name) for name in
                   ("SIGINT", "SIGTERM", "SIGHUP") if hasattr(signal, name))


@contextlib.contextmanager
def uninterrupted():
    """Hold SIGINT, SIGTERM and SIGHUP while a write sequence runs, so one
    that arrives lands once the sequence is whole, never between its files
    (the 2026-11-04 review: an interrupted promote left the brief and its
    deposit both, and promoting again refused E204). Released, a held SIGINT
    raises KeyboardInterrupt and a held SIGTERM or SIGHUP ends the process,
    as either would have. When the sequence raises instead, a refusal among
    them, nothing is released: the refusal is said, and the run ends with
    it. SIGKILL and a crash cannot be held, and where no signal can be (no
    `pthread_sigmask`: Windows), none is."""
    mask = getattr(signal, "pthread_sigmask", None)
    if mask is None:
        yield
        return
    mask(signal.SIG_BLOCK, INTERRUPTS)
    yield
    mask(signal.SIG_UNBLOCK, INTERRUPTS)


def interrupted() -> int:
    """After a SIGINT: one line where a traceback stood, then the end Python
    gives an unhandled KeyboardInterrupt, by SIGINT, so a calling shell
    stops as it would have. Where that end cannot be given, exit 130."""
    print("park: interrupted", file=sys.stderr)
    for stream in (sys.stdout, sys.stderr):
        with contextlib.suppress(OSError, ValueError):
            stream.flush()
    if os.name == "posix":
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        os.kill(os.getpid(), signal.SIGINT)
    return 130


def refusal(code: str, text: str) -> str:
    """One refusal line: its stable code, then the prose."""
    if code not in CODES:
        raise KeyError(f"undeclared refusal code {code}")
    return f"{code} {text}"


def _unquote(value: str) -> str:
    """Strip one pair of surrounding quotes: a value that opens with `"` or
    `'` and holds no other quote of that kind until its last character,
    which closes it. `"Alpha" and "Beta"` opens and ends with a quote but is
    no pair, so it reads as written (the 2026-11-04 review: it read as
    `Alpha" and "Beta`)."""
    if (len(value) >= 2 and value[0] in "'\"" and value[-1] == value[0]
            and value[0] not in value[1:-1]):
        return value[1:-1]
    return value


#: One item of an inline list and what ends it: a quoted item (`_unquote`'s
#: pair) may hold a comma, a plain one runs to the next comma.
INLINE_ITEM = re.compile(r"""\s*("[^"]*"|'[^']*'|[^,]*?)\s*(?:(,)|\Z)""")


def inline_items(inner: str) -> list[str]:
    """The items between an inline list's brackets, each unquoted. A comma
    inside a quoted item does not split it (the 2026-11-04 review:
    `["a, b", c]` read as three items); an empty item stays in the list as
    `""`, for the caller to refuse."""
    items, at = [], 0
    while True:
        m = INLINE_ITEM.match(inner, at)
        items.append(_unquote(m.group(1)))
        if m.group(2) is None:
            return items
        at = m.end()


def parse_front(path: Path, errors: list[str]) -> dict | None:
    """Parse one brief file's frontmatter, or None on failure."""
    rel = path.relative_to(ROOT)
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        errors.append(refusal("PARK-E102", f"{rel}: unreadable ({exc})"))
        return None
    return parse_text(rel, text, errors)


def parse_text(rel, text: str, errors: list[str]) -> dict | None:
    """Parse one brief's frontmatter into a dict, or None on failure.

    Accepts the ratified subset only: `key: scalar`, `key: [a, b]`, and
    `key:` followed by `  - item` lines, between two `---` fences.
    """
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        errors.append(refusal("PARK-E103", f"{rel}: no frontmatter — first "
                                           f"line must be ---"))
        return None
    data: dict = {}
    pending_list: str | None = None
    closed = False
    for n, raw in enumerate(lines[1:], start=2):
        line = raw.rstrip()
        if line.strip() == "---":
            closed = True
            body = "\n".join(lines[n:]).strip()
            data["_body"] = body
            break
        # A dash alone is an item too, an empty one (E109): it used to fall
        # through to E105 (the 2026-11-04 review).
        if line in ("-", "  -") or line.startswith(("- ", "  - ")):
            if pending_list is None:
                errors.append(refusal("PARK-E108", f"{rel}:{n}: list item "
                                                   f"outside a list field"))
                return None
            item = _unquote(line.lstrip()[1:].strip())
            if not item:
                errors.append(refusal("PARK-E109",
                                      f"{rel}:{n}: empty list item"))
                return None
            data[pending_list].append(item)
            continue
        if line.strip().startswith("#") or not line.strip():
            continue
        pending_list = None
        key, sep, value = line.partition(":")
        # A key opens its line: this grammar nests nothing, so an indented
        # key is refused rather than read as if it were not indented (the
        # 2026-11-04 review: this check stood after the strip, and never
        # fired).
        if not sep or key != key.lstrip():
            errors.append(refusal("PARK-E105", f"{rel}:{n}: not a "
                                               f"`key: value` line: {line!r}"))
            return None
        key = key.strip()
        if key not in FIELDS:
            errors.append(refusal("PARK-E106", f"{rel}:{n}: unknown field "
                                  f"{key!r} (schema fields: "
                                  f"{', '.join(FIELDS)})"))
            return None
        if key in data:
            errors.append(refusal("PARK-E107",
                                  f"{rel}:{n}: duplicate field {key!r}"))
            return None
        value = value.strip()
        if key in LIST_FIELDS:
            if value == "":
                data[key] = []
                pending_list = key
            elif value == "[]":
                data[key] = []
            elif value.startswith("[") and value.endswith("]"):
                inner = value[1:-1].strip()
                data[key] = inline_items(inner) if inner else []
                # `[,]` read as two empty items, and a watch took them as
                # its triggers (the 2026-11-04 review).
                if "" in data[key]:
                    errors.append(refusal("PARK-E109", f"{rel}:{n}: empty "
                                                       f"list item in {key}"))
                    return None
            else:
                errors.append(refusal("PARK-E110", f"{rel}:{n}: {key} must "
                                      f"be a list ([] / [a, b] / block "
                                      f"form), got {value!r}"))
                return None
        else:
            data[key] = _unquote(value)
    if not closed:
        errors.append(refusal("PARK-E104", f"{rel}: frontmatter never "
                                           f"closed with ---"))
        return None
    missing = False
    for field in FIELDS:
        if field not in data:
            if field in OPTIONAL_DEFAULTS:
                data[field] = list(OPTIONAL_DEFAULTS[field])
                continue
            errors.append(refusal("PARK-E111", f"{rel}: missing required "
                                               f"field {field!r}"))
            missing = True
    return None if missing else data


def unlistable(directory: Path) -> str | None:
    """Why `directory` cannot be listed, or None when it can.

    `Path.glob` answers `[]` for a directory it may not read, which is
    indistinguishable from an empty one: an unlistable `briefs/` would
    validate as zero briefs and map to an empty index. Every listing park
    acts on asks this first.
    """
    try:
        with os.scandir(directory):
            return None
    except OSError as exc:
        return exc.strerror or type(exc).__name__


def load_briefs(errors: list[str]) -> dict[str, dict]:
    if not BRIEFS.is_dir():
        errors.append(refusal("PARK-E101", f"{BRIEFS.relative_to(ROOT)}/: "
                                           f"directory does not exist"))
        return {}
    why = unlistable(BRIEFS)
    if why is not None:
        errors.append(refusal("PARK-E114", f"{BRIEFS.relative_to(ROOT)}/: "
                                           f"cannot be listed ({why})"))
        return {}
    briefs: dict[str, dict] = {}
    # NOT recursive, by design: `briefs/inbox/` holds deposits, which are
    # proposals and must never enter the index. A recursive glob would index
    # every deposit the day it landed.
    for path in sorted(BRIEFS.glob("*.md")):
        # A name opening with a dot is no brief: macOS writes `._<name>`
        # beside a file on some volumes, and one of those refused the whole
        # tree with E103 (the 2026-11-04 review).
        if path.name.startswith("."):
            continue
        rel = path.relative_to(ROOT)
        data = parse_front(path, errors)
        if data is None:
            continue
        bid = data["id"]
        if bid != path.stem:
            errors.append(refusal("PARK-E112", f"{rel}: id {bid!r} does not "
                                  f"match filename stem {path.stem!r} (one "
                                  f"brief, one file, one id)"))
            continue
        data["_path"] = rel
        briefs[bid] = data
    return briefs


def validate(briefs: dict[str, dict], errors: list[str]) -> None:
    for bid, b in sorted(briefs.items()):
        rel = b["_path"]
        if b["type"] not in TYPES:
            errors.append(refusal("PARK-E120", f"{rel}: type {b['type']!r} "
                                               f"not in {sorted(TYPES)}"))
        if b["status"] not in STATUSES:
            errors.append(refusal("PARK-E121", f"{rel}: status "
                                  f"{b['status']!r} not in {sorted(STATUSES)}"))
        if b["owner"] not in OWNERS:
            errors.append(refusal("PARK-E122", f"{rel}: owner "
                                  f"{b['owner']!r} not in {sorted(OWNERS)}"))
        if not b["brief"]:
            errors.append(refusal("PARK-E123", f"{rel}: brief is empty — it "
                                               f"is the map line"))
        if b["type"] == "watch":
            # The decided looseness: a watch is armed, not worked — it
            # carries status: open plus at least one trigger.
            if b["status"] != "open":
                errors.append(refusal("PARK-E124", f"{rel}: a watch carries "
                                      f"status: open (got {b['status']!r})"))
            if not b["triggers"]:
                errors.append(refusal("PARK-E125", f"{rel}: a watch needs at "
                                                   f"least one trigger"))
        # The index is split at this marker, so one rendered from a brief
        # would turn the lines after it into a preserved tail on every `map`.
        # An id cannot hold it: the rule below refuses its spaces.
        if any(END_MARK in v for v in (b["brief"], *b["gate"])):
            errors.append(refusal("PARK-E127", f"{rel}: carries the index's "
                                  f"end marker {END_MARK!r}"))
        # The index links each id as `briefs/<id>.md`, so an id holds only
        # what that link carries (the 2026-11-04 review: `id: "Foo Bar"`
        # validated and mapped to a broken link).
        odd = next((c for c in bid if c not in "._-"
                    and unicodedata.category(c)[0] not in "LNM"), None)
        if odd is not None:
            errors.append(refusal("PARK-E128", f"{rel}: id {bid!r} holds "
                                  f"{odd!r}; an id is letters, digits, `.`, "
                                  f"`_` and `-`"))
        # A `github:` origin is what outbound closes by and inbound
        # deduplicates on; one that does not parse would silently do
        # neither, so it is refused here rather than ignored there.
        opening = [l for l in b["_body"].splitlines() if l.strip()][:1]
        bad = malformed_github(opening[0]) if opening else None
        if bad is not None:
            errors.append(refusal("PARK-E126", f"{rel}: origin {bad!r} is not "
                                  f"github:[HOST/]OWNER/NAME#N"))
        resolved = []
        for g in b["gate"]:
            if g.startswith("manual:"):
                if not g[len("manual:"):].strip():
                    errors.append(refusal("PARK-E130", f"{rel}: gate "
                                          f"'manual:' carries no checkable "
                                          f"fact"))
                resolved.append(None)  # unresolvable by design
                continue
            if g == bid:
                errors.append(refusal("PARK-E131", f"{rel}: gate references "
                                                   f"the brief itself"))
                continue
            if g not in briefs:
                errors.append(refusal("PARK-E132", f"{rel}: gate {g!r} "
                                                   f"resolves to no brief"))
                continue
            resolved.append(briefs[g]["status"])
        # §3 refinement 1: the gate-opened pathology, mechanically.
        if (b["status"] == "parked" and b["gate"]
                and all(s in ("done", "superseded") for s in resolved)
                and None not in resolved
                and len(resolved) == len(b["gate"])):
            closed_gates = ", ".join(
                f"{g}: {briefs[g]['status']}" for g in b["gate"])
            errors.append(refusal("PARK-E133", f"{rel}: status parked but "
                                  f"every gate is closed ({closed_gates}) — "
                                  f"the gate has opened; work it or re-park "
                                  f"it on a real gate"))

    # §3 refinement 2: a deferral destination must be unresolvable in only
    # one direction. Two briefs both claiming the same id is not a lost
    # destination, it is an AMBIGUOUS one — a question prose adjacency
    # could never even ask, since nothing stopped two documents mentioning
    # the same words. Checked once, across the whole tree, because the
    # defect is between briefs rather than inside any single one.
    claimed_by: dict[str, list[str]] = {}
    for bid, b in sorted(briefs.items()):
        # A brief that lists an id twice still claims it once (the
        # 2026-11-04 review: `[x, x]` read as two briefs, "d, d").
        for d in dict.fromkeys(b["deferrals"]):
            claimed_by.setdefault(d, []).append(bid)
    for d, owners in sorted(claimed_by.items()):
        if len(owners) > 1:
            errors.append(refusal(
                "PARK-E134",
                f"deferral {d!r} is claimed by more than one brief's "
                f"deferrals: {', '.join(owners)} — a destination must "
                f"resolve to exactly one brief"))
    gate_cycles(briefs, errors)


def gate_cycles(briefs: dict[str, dict], errors: list[str]) -> None:
    """A cycle among live briefs can never open: each waits on the other.
    A closed brief blocks nothing, so it breaks one."""
    live = ("open", "parked")
    waits = {bid: [g for g in b["gate"] if g != bid and g in briefs
                   and briefs[g]["status"] in live]
             for bid, b in briefs.items() if b["status"] in live}
    seen: set[str] = set()
    for start in sorted(waits):
        if start in seen:
            continue
        # An explicit stack: a chain of gates may be deeper than Python's.
        seen.add(start)
        path, on_path, stack = [start], {start}, [iter(waits[start])]
        while stack:
            for g in stack[-1]:
                if g in on_path:
                    loop = path[path.index(g):] + [g]
                    errors.append(refusal(
                        "PARK-E135", f"{briefs[g]['_path']}: gates wait in a "
                                     f"cycle: {' -> '.join(loop)}"))
                elif g not in seen:
                    seen.add(g)
                    path.append(g)
                    on_path.add(g)
                    stack.append(iter(waits[g]))
                    break
            else:
                stack.pop()
                on_path.discard(path.pop())


def render_map(briefs: dict[str, dict]) -> str:
    def line(b: dict, with_gate: bool) -> str:
        head = (f"- [`{b['id']}`](briefs/{b['id']}.md) "
                f"({b['type']}, {b['owner']})")
        waiting = [g for g in b["gate"] if g.startswith("manual:")
                   or briefs[g]["status"] not in ("done", "superseded")]
        if with_gate and waiting:
            head += f" gate: {', '.join(waiting)}"
        return f"{head} — {b['brief']}"

    open_items = [b for b in briefs.values()
                  if b["status"] == "open" and b["type"] != "watch"]
    watches = [b for b in briefs.values() if b["type"] == "watch"]
    parked = [b for b in briefs.values() if b["status"] == "parked"]
    closed = [b for b in briefs.values()
              if b["status"] in ("done", "superseded")
              and b["type"] != "watch"]
    for group in (open_items, watches, parked):
        group.sort(key=lambda b: b["id"])

    out = [
        "# TODO — brief index",
        "",
        "<!-- GENERATED by park from briefs/*.md: edit a brief, then run "
        "`park map`. -->",
        "",
        "Choose the next piece of work here, then read that one brief. Closed "
        "briefs stay in",
        "`briefs/`: `rg -l '^status: (done|superseded)$' briefs`, or "
        "`rg <term> briefs`.",
        "",
    ]
    # Named only where it exists: the archive is this repository's choice,
    # not something the tool creates or can assume. A generated index that
    # points at a file the repository does not have is the drift this tool
    # is for, produced by the tool itself.
    archive = TODO.with_name(f"{TODO.stem}-archive{TODO.suffix}")
    if archive.is_file():
        out += [f"The closed record is `{archive.name}` — grep it, do not "
                f"load it per-session.", ""]
    sections = [
        ("Open", open_items, True),
        ("Watches", watches, False),
        ("Parked — waiting on a gate", parked, True),
    ]
    for title, group, with_gate in sections:
        out.append(f"## {title} ({len(group)})")
        out.append("")
        for b in group:
            out.append(line(b, with_gate))
        if group:
            out.append("")
    out.append(f"{len(closed)} closed brief(s) are not listed above.")
    out.append("")
    out.append(END_MARK)
    return "\n".join(out) + "\n"


def split_todo(text: str) -> tuple[str | None, str]:
    """Return (generated_head, preserved_tail); head None when unmarked."""
    if END_MARK not in text:
        return None, text
    head, _, tail = text.partition(END_MARK)
    return head + END_MARK + "\n", tail.lstrip("\n")


def compose_map(briefs: dict[str, dict]) -> tuple[str, str, str | None]:
    """(TODO.md as it is, what `map` would write, its generated head)."""
    rendered = render_map(briefs)
    try:
        current = TODO.read_text(encoding="utf-8") if TODO.is_file() else ""
    except (OSError, UnicodeDecodeError) as exc:
        raise Refused(refusal("PARK-E142", f"{TODO.name}: unreadable "
                                           f"({exc})")) from None
    # A second marker may be old damage or text someone quoted, and nothing
    # tells them apart, so nothing here rewrites the file.
    if current.count(END_MARK) > 1:
        raise Refused(refusal("PARK-E144", f"{TODO.name} carries "
                              f"{current.count(END_MARK)} of {END_MARK!r}: "
                              f"keep the one that ends the generated region, "
                              f"by hand; it is unchanged"))
    head, tail = split_todo(current)
    return current, rendered + ("\n" + tail if tail else ""), head


# ------------------------------------------------------------------ intake
#
# `briefs/inbox/` is the deposit queue: proposals from whoever cannot or
# should not write a brief directly — an analyst with no commit rights, an
# issue tracker, a script, a review's residue. A deposit is one file:
#
#     line 1  Deposited by <who>, <YYYY-MM-DD>, origin <origin>
#     line 2  the one-line map entry the promoted brief would carry
#     rest    the finding
#
# `<origin>` is a closed vocabulary — ORIGINS, or `github:<repo>#<N>` for
# issue N of one repository — carried on that line and in no frontmatter
# field. `<repo>` is `OWNER/NAME` on github.com and `HOST/OWNER/NAME` on any
# other host; a host always carries a dot and an owner never does, so the
# two cannot be read as each other. The repository is part of the origin
# because an issue number alone names nothing: `github#<N>`, the form 0.4.0
# wrote, let a brief imported from one repository close the same number in
# another. That form is still read, so it is found and refused (PARK-E218)
# wherever park would write it, deduplicate on it or close by it. A line 1
# with no `, origin ...` is the form written before 0.4.0: `promote` takes it
# with an explicit `--origin`, and `deposit` refuses it. Deposits never enter the
# index: the loader globs `briefs/*.md` and nothing deeper.

ORIGINS = ("analyst", "operator", "script", "review")
_HOST = r"[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+"
_OWNER = r"[A-Za-z0-9][A-Za-z0-9-]*"
_NAME = r"[A-Za-z0-9._-]+"
_REPO = (rf"(?:(?P<host>{_HOST})/)?(?P<owner>{_OWNER})/(?P<name>{_NAME})")
REPO_ARG = re.compile(_REPO)
BOUND_ORIGIN = re.compile(rf"github:{_REPO}#(?P<n>[1-9][0-9]*)")
GITHUB_ORIGIN = re.compile(r"github#([1-9][0-9]*)")      # 0.4.0, unbound
WORD_ORIGIN = re.compile(r"[a-z]+")
#: What may follow a GitHub origin on its line (`leading_origin`).
ORIGIN_END = re.compile(r"(?:$|\s|;|\.(?:$|\s))")
ISSUE_URL = re.compile(rf"https?://(?P<host>{_HOST})/(?P<owner>{_OWNER})/"
                       rf"(?P<name>{_NAME})/issues/(?P<n>[1-9][0-9]*)")
DEFAULT_HOST = "github.com"
SLUG = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
PROVENANCE = re.compile(
    r"Deposited by (?P<by>[A-Za-z0-9][A-Za-z0-9._-]*), "
    r"(?P<date>[0-9]{4}-[0-9]{2}-[0-9]{2})"
    r"(?:, origin (?P<origin>[a-z]+(?:[#:]\S*)?))?")
QUEUE_README = "README.md"
EDIT_HINT = "edit it by hand to `github:OWNER/NAME#{n}`"


class Refused(Exception):
    """An intake refusal: one or more coded lines."""

    def __init__(self, *lines: str):
        super().__init__(lines[0])
        self.lines = lines


class Repo:
    """One GitHub repository. Equal by what GitHub treats as the same
    repository: the host lower-cased, owner and name without regard to case.
    Spelled as written, with the host left out on github.com."""

    def __init__(self, host: str | None, owner: str, name: str):
        self.host = (host or DEFAULT_HOST).lower()
        self.owner, self.name = owner, name

    @classmethod
    def of(cls, m: re.Match) -> "Repo":
        return cls(m["host"], m["owner"], m["name"])

    def key(self) -> tuple[str, str, str]:
        return (self.host, self.owner.casefold(), self.name.casefold())

    def __eq__(self, other) -> bool:
        return isinstance(other, Repo) and self.key() == other.key()

    def __hash__(self) -> int:
        return hash(self.key())

    def __str__(self) -> str:
        path = f"{self.owner}/{self.name}"
        return path if self.host == DEFAULT_HOST else f"{self.host}/{path}"

    def origin(self, n: int) -> str:
        return f"github:{self}#{n}"


def origin_valid(origin: str) -> bool:
    """In the vocabulary, the 0.4.0 `github#N` included: it is READ, so it
    can be named; `need_bound` refuses writing or acting on it."""
    return (origin in ORIGINS or BOUND_ORIGIN.fullmatch(origin) is not None
            or GITHUB_ORIGIN.fullmatch(origin) is not None)


def origin_words() -> str:
    return f"{', '.join(ORIGINS)}, github:[HOST/]OWNER/NAME#<N>"


def bound_origin(origin: str | None) -> tuple[Repo, int] | None:
    m = BOUND_ORIGIN.fullmatch(origin or "")
    return (Repo.of(m), int(m["n"])) if m else None


def legacy_number(origin: str | None) -> int | None:
    """N for a 0.4.0 `github#N` origin, which names no repository."""
    m = GITHUB_ORIGIN.fullmatch(origin or "")
    return int(m.group(1)) if m else None


def issue_url(text: str | None) -> tuple[Repo, int] | None:
    m = ISSUE_URL.fullmatch((text or "").strip())
    return (Repo.of(m), int(m["n"])) if m else None


WRITE_HINT = "write `github:OWNER/NAME#{n}` instead"


def need_bound(origin: str | None, where: str, hint: str = EDIT_HINT) -> None:
    """Refuse a 0.4.0 `github#N` origin where park would write or act on
    it; `hint` says what to do instead, `{n}` standing for its number."""
    n = legacy_number(origin)
    if n is not None:
        raise Refused(refusal("PARK-E218", f"{where}: origin github#{n} names "
                              f"no repository; {hint.format(n=n)}"))


def parse_provenance(line: str, where: str) -> re.Match:
    """Line 1, strictly: the whole line, a real calendar date, and an origin
    from the vocabulary when one is declared."""
    m = PROVENANCE.fullmatch(line.strip())
    if m is None:
        raise Refused(refusal("PARK-E206", f"{where}: line 1 must read "
                              f"`Deposited by <who>, <YYYY-MM-DD>, origin "
                              f"<origin>`; it reads {line!r}"))
    try:
        datetime.date.fromisoformat(m["date"])
    except ValueError:
        raise Refused(refusal("PARK-E206", f"{where}: line 1 carries no real "
                              f"date ({m['date']!r})")) from None
    if m["origin"] is not None and not origin_valid(m["origin"]):
        raise Refused(refusal("PARK-E207", f"{where}: origin "
                              f"{m['origin']!r} is not one of "
                              f"{origin_words()}"))
    return m


def leading_origin(line: str) -> str | None:
    """The origin a provenance line OPENS with: a brief's body may continue
    that line with prose (`...; promoted by ...`). The longest well-formed
    origin at that place wins. A GitHub origin ends only at a DELIMITER —
    the end of the line, whitespace, `;`, or a `.` that ends the line or
    precedes whitespace — so one running on into more of a token
    (`github:o/r#7x`, `#7-extra`, `#7/extra`, `#7.5`) names no issue and is
    none. A word origin ends at anything but a letter, digit, `#` or `_`.
    Answers only "which origin does this record?"; `malformed_github` is
    the check."""
    text = line.strip()
    m = PROVENANCE.match(text)
    if m is None or m["origin"] is None:
        return None
    for shape in (BOUND_ORIGIN, GITHUB_ORIGIN, WORD_ORIGIN):
        t = shape.match(text, m.start("origin"))
        if t is not None:
            break
    rest = text[t.end():]
    if shape is WORD_ORIGIN:
        after = rest[:1]
        return None if after and (after.isalnum() or after in "#_") \
            else t.group(0)
    return t.group(0) if ORIGIN_END.match(rest) else None


def malformed_github(line: str) -> str | None:
    """The origin text, when a provenance line declares a `github:` origin
    that does not read as one; None otherwise (no provenance line, another
    origin, or a well-formed one)."""
    m = PROVENANCE.match(line.strip())
    if m is None or m["origin"] is None or \
            not m["origin"].startswith("github:"):
        return None
    return None if bound_origin(leading_origin(line)) else m["origin"]


def one_line(value: str) -> bool:
    return bool(value) and value.splitlines() == [value]


def lines_of(text: str) -> list[str]:
    """A deposit's lines, split at a newline only (CR LF and a lone CR read
    as one, as text mode reads them). A form feed, NEL or U+2028 stays in
    its line, so a promotion keeps the body as written, and a map line
    holding one is refused (E211) where `splitlines` cut it there (the
    2026-11-04 review: `first<U+2028>second` became `brief: first`)."""
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    if lines[-1] == "":
        lines.pop()
    return lines


def deposit_path(did: str) -> Path:
    return INBOX / f"{did}.md"


def need_slug(did: str) -> None:
    if not SLUG.fullmatch(did):
        raise Refused(refusal("PARK-E201", f"{did!r} is not a lowercase "
                              f"kebab slug ([a-z0-9] words joined by -)"))


def is_queue_readme(path: Path) -> bool:
    """Whether `path`, a name in the inbox, is the queue's own README.

    Two rules, because each sees what the other cannot. By NAME: any name
    whose casefold is `readme.md` is reserved on every filesystem, so a
    case-sensitive one refuses exactly the spellings a case-insensitive one
    resolves to the README, and no id can create a file that becomes the
    README when the tree is opened on the other kind. By IDENTITY: whatever
    names the same file as `briefs/inbox/README.md` when that exists, as a
    directory entry or through a link. That is the filesystem's own answer,
    covering any folding or normalisation beyond Python's casefold. On
    case-insensitive APFS, measured 2026-09-23, the two agree on every
    name (no other code point stands for a letter of `readme`, and none
    inserted into it is ignored), so there identity adds only the links.
    """
    if path.name.casefold() == QUEUE_README.casefold():
        return True
    readme = INBOX / QUEUE_README
    for probe in (os.lstat, os.stat):
        try:
            if os.path.samestat(probe(path), probe(readme)):
                return True
        except OSError:
            continue
    return False


def deposits() -> list[Path]:
    """Every deposit: `*.md` directly under the inbox, its README aside."""
    if not INBOX.is_dir():
        return []
    why = unlistable(INBOX)
    if why is not None:
        raise Refused(refusal("PARK-E217", f"{INBOX.relative_to(ROOT)}/: "
                                           f"cannot be listed ({why})"))
    return sorted(p for p in INBOX.glob("*.md")
                  if not is_queue_readme(p) and p.is_file())


def read_deposit(path: Path) -> list[str]:
    rel = path.relative_to(ROOT)
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        raise Refused(refusal("PARK-E205", f"{rel}: not UTF-8 text")) \
            from None
    except OSError as exc:
        raise Refused(refusal("PARK-E217", f"{rel}: unreadable "
                              f"({exc.strerror or type(exc).__name__})")) \
            from None
    lines = lines_of(text)
    if not lines or not lines[0].strip():
        raise Refused(refusal("PARK-E205", f"{rel}: empty, or line 1 is "
                                           f"blank"))
    return lines


def map_line(lines: list[str], where: str) -> str:
    line = lines[1].strip() if len(lines) > 1 else ""
    if not line:
        raise Refused(refusal("PARK-E210", f"{where}: line 2 must be the "
                              f"one-line map entry; it is missing or blank"))
    return line


class Record(NamedTuple):
    """One GitHub origin already recorded in the tree."""
    path: Path
    origin: str             # the origin as written
    settled: bool           # a brief whose status is done or superseded

    @property
    def rel(self) -> str:
        return str(self.path.relative_to(ROOT))


def github_records() -> list[Record]:
    """Every GitHub origin, bound or 0.4.0, already recorded: on a deposit's
    line 1, or the first body line of a brief. Briefs are read leniently
    here (any file whose frontmatter closes): this answers "seen before?",
    it validates nothing.

    Fail-closed on what it cannot SEE, lenient on what it cannot DECODE. A
    file or directory it cannot read might record the very issue asked
    about, so that refuses (E217 for the queue, E114/E102 for the briefs)
    instead of being skipped into a duplicate. Bytes that are not UTF-8 are
    decoded with replacement: the provenance line is ASCII, so no decoding
    choice can hide or forge one, and junk elsewhere in a file no longer
    hides the line it opens with."""
    found: list[Record] = []

    def note(path: Path, line: str, settled: bool = False) -> None:
        origin = leading_origin(line)
        if bound_origin(origin) is not None or legacy_number(origin) is not None:
            found.append(Record(path, origin, settled))

    for path in deposits():
        rel = path.relative_to(ROOT)
        try:
            raw = path.read_bytes()
        except OSError as exc:
            raise Refused(refusal("PARK-E217", f"{rel}: unreadable, so it "
                                  f"cannot be checked for a github origin "
                                  f"({exc.strerror or type(exc).__name__})")) \
                from None
        lines = raw.decode("utf-8", "replace").splitlines()
        if lines:
            note(path, lines[0])
    if not BRIEFS.is_dir():
        return found
    why = unlistable(BRIEFS)
    if why is not None:
        raise Refused(refusal("PARK-E114", f"{BRIEFS.relative_to(ROOT)}/: "
                                           f"cannot be listed ({why})"))
    for path in sorted(BRIEFS.glob("*.md")):
        try:
            raw = path.read_bytes()
        except OSError as exc:
            raise Refused(refusal("PARK-E102", f"{path.relative_to(ROOT)}: "
                                  f"unreadable, so it cannot be checked for "
                                  f"a github origin "
                                  f"({exc.strerror or type(exc).__name__})")) \
                from None
        lines = raw.decode("utf-8", "replace").splitlines()
        fences = [i for i, l in enumerate(lines) if l.strip() == "---"]
        if len(fences) < 2 or fences[0] != 0:
            continue
        first = next((i for i in range(fences[1] + 1, len(lines))
                      if lines[i].strip()), None)
        if first is not None:
            status = next((l.split(":", 1)[1].strip() for l in lines[:fences[1]]
                           if l.startswith("status:")), None)
            note(path, lines[first], status in ("done", "superseded"))
    return found


def recorded(records: list[Record]) -> tuple[dict, dict[int, list[str]]]:
    """(repository, N) -> where a bound origin records it; N -> every file
    whose 0.4.0 `github#N` origin could be recording it, for any
    repository."""
    bound: dict[tuple[Repo, int], str] = {}
    legacy: dict[int, list[str]] = {}
    for r in records:
        b = bound_origin(r.origin)
        if b is not None:
            bound.setdefault(b, r.rel)
        else:
            legacy.setdefault(legacy_number(r.origin), []).append(r.rel)
    return bound, legacy


def unbound_conflict(legacy: dict[int, list[str]], repo: Repo,
                     n: int) -> str:
    return refusal("PARK-E218", f"{legacy[n][0]}: origin github#{n} names no "
                   f"repository, so it cannot say whether {repo.origin(n)} "
                   f"is recorded already; {EDIT_HINT.format(n=n)}")


def scaffold(bid: str, btype: str, triggers: list[str], line: str,
             body: str) -> str:
    trig = ("triggers: []" if not triggers else
            "triggers:\n" + "\n".join(f"  - {t}" for t in triggers))
    return (f"---\nid: {bid}\ntype: {btype}\nstatus: open\nowner: user\n"
            f"gate: []\n{trig}\ndeferrals: []\nbrief: {line}\n---\n\n"
            f"{body}")


def survives(bid: str, btype: str, triggers: list[str], line: str) -> None:
    """Every value written into frontmatter must read back as itself."""
    for value in (line, *triggers):
        if not one_line(value) or value != value.strip():
            raise Refused(refusal("PARK-E211", f"{value!r} is blank, "
                                  f"multi-line or padded"))
    if END_MARK in line:
        raise Refused(refusal("PARK-E127", f"{line!r} carries the index's "
                              f"end marker"))
    errors: list[str] = []
    data = parse_text(f"briefs/{bid}.md",
                      scaffold(bid, btype, triggers, line, "x\n"), errors)
    want = {"id": bid, "type": btype, "status": "open", "owner": "user",
            "gate": [], "triggers": list(triggers), "deferrals": [],
            "brief": line}
    got = {k: data[k] for k in want} if data else None
    if got != want:
        raise Refused(refusal("PARK-E211", f"a value does not read back as "
                              f"itself through the frontmatter subset "
                              f"(wrote {want}, reads back {got})"))


def create_file(path: Path, text: str, made: list[Path]) -> None:
    """Create-only: never overwrites. Records the file for a rollback."""
    with open(path, "x", encoding="utf-8") as handle:
        made.append(path)
        handle.write(text)


def rollback(made: list[Path], restore: dict) -> list[str]:
    """Undo, newest first: remove what was created, put back the bytes of
    what was changed or removed (None: it did not exist before). Then READ
    BACK every path and return, relative to the root, each one that is not
    as it was: [] is the only answer that lets a caller say every file was
    restored (2026-11-02: an undo that failed itself was silent, and the
    refusal still said every file was restored). An undo is attempted for
    each path whatever an earlier one did."""
    for path in reversed(made):
        try:
            path.unlink()
        except OSError:
            pass
    for path, data in restore.items():
        try:
            if data is None:
                path.unlink(missing_ok=True)
            else:
                write_atomic(path, data)
        except OSError:
            pass
    want = {path: None for path in made if path not in restore}
    want.update(restore)
    uncertain = []
    for path, data in want.items():
        try:
            now = (path.read_bytes() if path.is_file()
                   else None if not os.path.lexists(path) else ...)
        except OSError:
            now = ...
        if now != data:
            uncertain.append(path)
    return [shown(path) for path in uncertain]


def shown(path: Path) -> str:
    """A path as a refusal names it: relative to the root where it can be."""
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def undone(uncertain: list[str], clean: str) -> str:
    """What a refusal says about its undo: `clean` only when `rollback`
    read every path back as it was, else the paths it could not."""
    if not uncertain:
        return clean
    return (f"the undo could not be confirmed for {', '.join(uncertain)}: "
            f"each may be partly written, missing or left behind; check "
            f"each by hand (`git status`, `git diff`) before running this "
            f"again")


def drop_new_inbox(new_dir: bool, uncertain: list[str]) -> list[str]:
    """Remove the inbox a failed write created, and say so if it stays."""
    if new_dir:
        try:
            INBOX.rmdir()
        except OSError:
            pass
        if os.path.lexists(INBOX):
            uncertain = [*uncertain, shown(INBOX) + "/"]
    return uncertain


def deposit_checks(did: str, path: Path) -> tuple[list[str], re.Match, str]:
    """What `promote` refuses of a deposit whatever its flags. `list` asks
    the same and validates the tree with the deposit added, as promote
    does, and no more: it reads no `TODO.md`, so what promote refuses there
    (E142, E144) or cannot write shows at promote alone."""
    rel = str(path.relative_to(ROOT))
    need_slug(did)
    if (BRIEFS / f"{did}.md").exists():
        raise Refused(refusal("PARK-E204", f"briefs/{did}.md exists; a "
                              f"promotion never overwrites a brief"))
    lines = read_deposit(path)
    m = parse_provenance(lines[0], rel)
    need_bound(m["origin"], rel)
    line = map_line(lines, rel)
    survives(did, "task", [], line)
    return lines, m, line


def promoted_text(did: str, btype: str, triggers: list[str],
                  lines: list[str], provenance: str, line: str) -> str:
    rest = lines[2:]
    while rest and not rest[0].strip():
        rest = rest[1:]
    body = provenance + "\n" + ("\n" + "\n".join(rest) + "\n" if rest else "")
    return scaffold(did, btype, triggers, line, body)


def with_candidate(did: str, text: str, loaded: dict, load_errors: list[str]):
    """(the tree with this brief added, its path, every error in that tree):
    what a promotion is judged by, since the brief may be what a gate needs."""
    rel = BRIEFS.relative_to(ROOT) / f"{did}.md"
    briefs, errors = dict(loaded), list(load_errors)
    data = parse_text(rel, text, errors)
    if data is not None:
        data["_path"] = rel
        briefs[did] = data
    validate(briefs, errors)
    return briefs, rel, errors


def not_deposits(found: list[Path]) -> list[Path]:
    """Each file waiting in the inbox that is no deposit: a regular file
    directly in it, its name not opening with a dot, neither a deposit nor
    the queue's README; the session-start hook names these as waiting too
    (the 2026-11-04 review: `finding.txt` was named there, listed by nothing
    and refused by `reject`, so nothing said how to clear it)."""
    taken = set(found)
    return sorted(p for p in INBOX.iterdir()
                  if not p.name.startswith(".") and p not in taken
                  and not is_queue_readme(p) and p.is_file())


def intake_list(args) -> int:
    where = f"{INBOX.relative_to(ROOT)}/"
    if not INBOX.is_dir():
        print(f"park: 0 deposit(s) ({where} does not exist)")
        return 0
    found = deposits()
    others = not_deposits(found)
    print(f"park: {len(found)} deposit(s) in {where}"
          + (f", and {len(others)} file(s) that are not one" if others else ""))
    load_errors: list[str] = []
    loaded = load_briefs(load_errors) if found else {}
    for path in found:
        try:
            lines, m, line = deposit_checks(path.stem, path)
            text = promoted_text(path.stem, "task", [], lines,
                                 lines[0].strip(), line)
            errors = with_candidate(path.stem, text, loaded, load_errors)[2]
            if errors:
                raise Refused(refusal("PARK-E215", f"{len(errors)} error(s) "
                                      f"with it added, first: {errors[0]}"))
            origin = m["origin"] or "none (promote needs --origin)"
            print(f"  {path.stem}  origin {origin}  {m['date']}  by "
                  f"{m['by']} — {line}")
        except Refused as exc:
            print(f"  {path.stem}  NOT PROMOTABLE: {exc.lines[0]}")
    for path in others:
        print(f"  {path.name}  NOT A DEPOSIT: only `<id>.md` is one; rename "
              f"it to one to promote it, or remove it by hand")
    return 0


def reserved(did: str, code: str) -> None:
    """Refuse an id naming the queue's README, before anything else about
    it is judged, so every spelling of that name gets the same code from a
    verb whatever else is wrong with it and whichever filesystem it is on."""
    if is_queue_readme(deposit_path(did)):
        raise Refused(refusal(code, f"{did!r} names the queue's own "
                              f"{INBOX.relative_to(ROOT)}/{QUEUE_README}, "
                              f"which is not a deposit in any letter case"))


def deposit_input(args) -> bytes:
    """The deposit's text, from `--file` or stdin: read failures refused."""
    where = f"--file {args.file}" if args.file is not None else "stdin"
    try:
        if args.file is not None:
            return Path(args.file).read_bytes()
        if sys.stdin is None:
            raise OSError(0, "no standard input")
        return sys.stdin.buffer.read()
    except OSError as exc:
        raise Refused(refusal("PARK-E217", f"{where}: unreadable "
                              f"({exc.strerror or type(exc).__name__})")) \
            from None


def need_tree() -> None:
    """A deposit queues into a tree that exists; park never starts one."""
    if not BRIEFS.is_dir():
        raise Refused(refusal("PARK-E101", f"{BRIEFS.relative_to(ROOT)}/: "
                                           f"directory does not exist"))


def intake_deposit(args) -> int:
    need_tree()
    reserved(args.id, "PARK-E216")
    need_slug(args.id)
    path = deposit_path(args.id)
    rel = f"{INBOX.relative_to(ROOT)}/{args.id}.md"
    if path.exists():
        raise Refused(refusal("PARK-E203", f"{rel} exists; a deposit is "
                                           f"never overwritten"))
    if (BRIEFS / f"{args.id}.md").exists():
        raise Refused(refusal("PARK-E204", f"briefs/{args.id}.md exists; "
                                           f"choose another id"))
    raw = deposit_input(args)
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise Refused(refusal("PARK-E205", "the deposit text is not UTF-8")) \
            from None
    lines = lines_of(text)
    if not lines or not lines[0].strip():
        raise Refused(refusal("PARK-E205", "the deposit text is empty, or "
                                           "its line 1 is blank"))
    m = parse_provenance(lines[0], "deposit")
    if m["origin"] is None:
        raise Refused(refusal("PARK-E208", f"deposit: line 1 declares no "
                              f"origin; end it with `, origin <origin>` "
                              f"({origin_words()})"))
    need_bound(m["origin"], "deposit", WRITE_HINT)
    survives(args.id, "task", [], map_line(lines, "deposit"))
    # The input is read before the lock, so a stdin nobody closes holds no
    # one up; the checks the file's creation rests on are asked again under
    # it, and the creation is made before it is released (S10-F5).
    with tree_lock():
        if path.exists():
            raise Refused(refusal("PARK-E203", f"{rel} exists; a deposit is "
                                               f"never overwritten"))
        if (BRIEFS / f"{args.id}.md").exists():
            raise Refused(refusal("PARK-E204", f"briefs/{args.id}.md exists; "
                                               f"choose another id"))
        need_unrecorded(m["origin"])
        return deposit_write(path, rel, text, m["origin"])


def need_unrecorded(origin: str | None, besides: Path | None = None) -> None:
    """Refuse a GitHub origin some file other than `besides` already
    records (E213), or that a 0.4.0 `github#N` origin could be recording
    (E218). Only a github origin can be a duplicate; scanning for any other
    would let an unreadable, unrelated file refuse an analyst's deposit.

    The check half of one protected operation (S10-F5, the 2026-11-08
    review): every caller holds `tree_lock` from this call until its file
    is written — deposit, import and promotion alike — so two of them can
    never both pass it on the old tree."""
    issue = bound_origin(origin)
    if issue is None:
        return
    seen, legacy = recorded([r for r in github_records()
                             if r.path != besides])
    if issue in seen:
        raise Refused(refusal("PARK-E213", f"{origin} is already "
                              f"recorded in {seen[issue]}"))
    if issue[1] in legacy:
        raise Refused(unbound_conflict(legacy, *issue))


def deposit_write(path: Path, rel: str, text: str, origin: str) -> int:
    made: list[Path] = []
    new_dir = not INBOX.is_dir()
    with uninterrupted():
        try:
            INBOX.mkdir(parents=True, exist_ok=True)
            create_file(path, text if text.endswith("\n") else text + "\n",
                        made)
        except OSError as exc:
            left = drop_new_inbox(new_dir, rollback(made, {}))
            code = ("PARK-E203" if isinstance(exc, FileExistsError)
                    else "PARK-E214")
            raise Refused(refusal(code, f"writing {rel} failed ({exc}); "
                                        + undone(left, "nothing was left "
                                                 "behind"))) from None
        print(f"park: deposited {rel} (origin {origin})", flush=True)
    return 0


def intake_promote(args) -> int:
    reserved(args.id, "PARK-E202")
    need_slug(args.id)
    path = deposit_path(args.id)
    rel = f"{INBOX.relative_to(ROOT)}/{args.id}.md"
    if not path.is_file():
        raise Refused(refusal("PARK-E202", f"{rel} does not exist"))
    target = BRIEFS / f"{args.id}.md"
    lines, m, line = deposit_checks(args.id, path)
    provenance = lines[0].strip()
    if m["origin"] is None:
        if args.origin is None:
            raise Refused(refusal("PARK-E208", f"{rel}: line 1 declares no "
                                  f"origin; pass --origin <origin> "
                                  f"({origin_words()})"))
        if not origin_valid(args.origin):
            raise Refused(refusal("PARK-E207", f"--origin {args.origin!r} is "
                                  f"not one of {origin_words()}"))
        need_bound(args.origin, "--origin", WRITE_HINT)
        provenance += f", origin {args.origin}"
    elif args.origin is not None:
        raise Refused(refusal("PARK-E209", f"{rel}: line 1 already declares "
                              f"origin {m['origin']}; drop --origin"))
    # The brief inserts its origin as much as a deposit does — `--origin`
    # adds one, and a deposit placed in the queue by hand never met
    # `deposit`'s check — so it is checked against every OTHER file here,
    # under the lock `run` holds for the whole promotion (S10-F5).
    need_unrecorded(m["origin"] or args.origin, besides=path)
    triggers = list(args.trigger or [])
    survives(args.id, args.type, triggers, line)
    text = promoted_text(args.id, args.type, triggers, lines, provenance, line)

    load_errors: list[str] = []
    loaded = load_briefs(load_errors)
    briefs, brief_rel, errors = with_candidate(args.id, text, loaded,
                                               load_errors)
    if errors:
        raise Refused(*errors, refusal("PARK-E215", f"{len(errors)} error(s) "
                                       f"with {brief_rel} added; nothing was "
                                       f"written"))
    current, want, _ = compose_map(briefs)

    made: list[Path] = []
    restore: dict = {}
    with uninterrupted():
        try:
            create_file(target, text, made)
            if current != want:
                restore[TODO] = TODO.read_bytes() if TODO.is_file() else None
                write_atomic(TODO, want.encode("utf-8"))
            restore[path] = path.read_bytes()
            path.unlink()
        except OSError as exc:
            left = rollback(made, restore)
            raise Refused(refusal("PARK-E214", f"promoting {rel} failed "
                                  f"({exc}); " + undone(
                                      left, "every file was restored"))) \
                from None
        # Said while still held, so an interrupt released next ends a run
        # whose last line says the promotion is whole.
        print(f"park: promoted {rel} to {brief_rel} (type {args.type}, owner "
              f"user); map written ({len(briefs)} briefs); deposit removed",
              flush=True)
    return 0


def intake_reject(args) -> int:
    did = args.id
    path = deposit_path(did)
    rel = f"{INBOX.relative_to(ROOT)}/{did}.md"
    if not did or "/" in did or "\\" in did or did.startswith("."):
        raise Refused(refusal("PARK-E202", f"{rel} names no deposit"))
    reserved(did, "PARK-E202")
    if not path.is_file():
        raise Refused(refusal("PARK-E202", f"{rel} names no deposit"))
    reason = args.reason.strip()
    if not one_line(reason):
        raise Refused(refusal("PARK-E212", "--reason must be one non-blank "
                                           "line"))
    # The read only feeds the record line. A deposit reject cannot read is
    # still rejected, because clearing what cannot be promoted is this verb's
    # job and `list` points at it for exactly that; the line says what was
    # read, and never claims a provenance it could not see.
    unread = None
    try:
        first = path.read_text(encoding="utf-8").splitlines()[:1]
    except UnicodeDecodeError:
        first = []
    except OSError as exc:
        first, unread = [], exc.strerror or type(exc).__name__
    m = PROVENANCE.fullmatch(first[0].strip()) if first else None
    what = (f"deposited by {m['by']}, {m['date']}, origin "
            f"{m['origin'] or 'none'}" if m
            else f"unreadable ({unread}), provenance unknown" if unread
            else "no provenance line")
    try:
        path.unlink()
    except OSError as exc:
        raise Refused(refusal("PARK-E214", f"removing {rel} failed ({exc}); "
                                           f"it is unchanged")) from None
    print(f"park: rejected {rel} ({what}): {reason}")
    return 0


# ------------------------------------------------------------------ GitHub
#
# Inbound reads the forge and writes only local deposits: `gh issue list`
# becomes one deposit per open issue not already recorded as `origin
# github:<repo>#N` (a deposit's line 1, or a brief body's first line), the
# repository taken from the issue's own URL as the forge reports it, never
# from how `--repo` was spelled. Outbound prints a plan by default: it names
# its repository with `--repo`, sets aside every done brief bound to another
# one without asking the forge anything about it, and reads each remaining
# issue with `gh issue view`, planning a close only when the URL the forge
# answers names that same repository and number. Only `--apply` writes to
# the forge, one `gh issue close --comment` per planned issue.
# No Project API is used, and nothing here runs on a schedule: every run is
# someone's command. An open issue with a comment stays on the forge unless
# `--with-commented` asks for it. A rejected issue comes back on the next
# import unless it is closed, commented or filtered out with `--label`.

GH_TIMEOUT = 120


def gh_path() -> str:
    path = shutil.which("gh")
    if path is None:
        raise Refused(refusal("PARK-E301", "`gh`, the GitHub CLI, is not on "
                              "PATH; install and authenticate it, then "
                              "re-run"))
    return path


def gh(exe: str, args: list[str], repo: str | None) -> str:
    argv = [exe, *args] + (["--repo", repo] if repo else [])
    what = f"gh {' '.join(args[:2])}"
    try:
        r = subprocess.run(argv, capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=GH_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise Refused(refusal("PARK-E302", f"`{what}` timed out after "
                                           f"{GH_TIMEOUT}s")) from None
    except OSError as exc:
        raise Refused(refusal("PARK-E302", f"`{what}` could not run "
                                           f"({exc})")) from None
    if r.returncode != 0:
        tail = ((r.stderr or r.stdout).strip().splitlines() or ["?"])[-1]
        raise Refused(refusal("PARK-E302", f"`{what}` exited "
                                           f"{r.returncode}: {tail}"))
    return r.stdout


def gh_json(exe: str, args: list[str], repo: str | None, shape):
    try:
        data = json.loads(gh(exe, args, repo))
    except json.JSONDecodeError:
        data = None
    if not shape(data):
        raise Refused(refusal("PARK-E303", f"`gh {' '.join(args[:2])}` did "
                                           f"not answer the expected JSON"))
    return data


def url_names(item: dict) -> tuple[Repo, int] | None:
    """(repository, N) from an answer's `url`, when it is issue N's URL."""
    url = item.get("url")
    where = issue_url(url) if isinstance(url, str) else None
    return where if where and where[1] == item.get("number") else None


def is_issue(item) -> bool:
    return (isinstance(item, dict) and type(item.get("number")) is int
            and item["number"] > 0 and isinstance(item.get("title"), str)
            and url_names(item) is not None
            and isinstance(item.get("body"), (str, type(None)))
            and isinstance(item.get("comments"), list))


def issue_id(number: int, title: str, repo: Repo | None = None,
             fingerprint: bool = False) -> str:
    """`gh-<N>-<title words>`; with `repo`, `gh-<repo words>-<N>-<title
    words>`; with `fingerprint` too, the repository's words followed by 8 hex
    digits of its identity (host, owner and name as GitHub compares them).
    Words alone lose the owner/name boundary and a name's punctuation, so
    `o-b/c` and `o/b-c`, or `o/r.name` and `o/r_name`, spell the same words;
    the fingerprint tells them apart."""
    slug = "-".join(re.findall(r"[a-z0-9]+", title.lower()))[:40].strip("-")
    where = ""
    if repo is not None:
        where = "-".join(re.findall(r"[a-z0-9]+", str(repo).lower())) + "-"
        if fingerprint:
            where += hashlib.sha256("/".join(repo.key()).encode(
                "utf-8")).hexdigest()[:8] + "-"
    return f"gh-{where}{number}" + (f"-{slug}" if slug else "")


def issue_deposit_path(repo: Repo, n: int, title: str,
                       origin_at: dict[Path, str]) -> Path:
    """Where issue N of `repo` is deposited (0.4.3). The short id while no
    deposit or brief holds it; when one does and records ANOTHER issue's
    bound origin, the id that names the repository too, and when that is
    held the same way (two repositories whose names spell the same words),
    the id carrying the repository's fingerprint. So issues of one number
    and title can wait in the queue together, and all promote, from
    repositories whose words or fingerprints differ. Three ids is the whole
    allocation: when all three are held by other issues (two repositories
    whose words and 8-digit fingerprints both match, which takes names
    built to collide), the import refuses (E304) and writes nothing, and
    that issue is deposited by hand under an id of the operator's choosing
    (`intake deposit`); its origin then dedupes later imports. A holder
    recording no other issue's origin may be this issue with its
    provenance edited away: that refuses (E304), as before 0.4.3, rather
    than make a second copy of it."""
    ids = (issue_id(n, title), issue_id(n, title, repo),
           issue_id(n, title, repo, fingerprint=True))
    for did in ids:
        holders = [h for h in (deposit_path(did), BRIEFS / f"{did}.md")
                   if h.exists()]
        if not holders:
            return deposit_path(did)
        for h in holders:
            other = bound_origin(origin_at.get(h))
            if other is None or other == (repo, n):
                raise Refused(refusal("PARK-E304", f"{h.relative_to(ROOT)} "
                                      f"exists and does not record another "
                                      f"issue, so it may be "
                                      f"{repo.origin(n)}'s; nothing was "
                                      f"written"))
    raise Refused(refusal("PARK-E304", f"every id for {repo.origin(n)} is "
                          f"held by another issue ({', '.join(ids)}); "
                          f"nothing was written"))


def issue_line(number: int, title: str) -> str:
    """The map line: the title on one line, or, when the title would not
    read back through the frontmatter subset, the title after a prefix."""
    line = " ".join(title.split()) or f"issue #{number} (no title)"
    try:
        survives("gh", "task", [], line)
    except Refused:
        line = f"issue #{number}: {line}"
    return line


def is_view(data) -> bool:
    return (isinstance(data, dict) and isinstance(data.get("state"), str)
            and isinstance(data.get("url"), str)
            and issue_url(data["url"]) is not None)


def gone_from_forge(exe: str, records: list[Record], listed: set,
                    only: Repo | None) -> list[str]:
    """One line per deposit or live brief whose issue is no longer open: the
    list says only what is open and labelled, so each origin it left out is
    read (the 2026-11-04 review: `bin/estate issues` closes issues itself). A
    read that fails is said and stops nothing, the deposits being written."""
    lines = []
    for r in records:
        issue = bound_origin(r.origin)
        if issue is None or r.settled or issue in listed or (
                only is not None and issue[0] != only):
            continue
        origin = r.origin
        try:
            state = gh_json(exe, ["issue", "view", str(issue[1]), "--json",
                                  "number,state,url"], str(issue[0]),
                            is_view)["state"]
        except Refused as exc:
            lines.append(f"  {origin} ({r.rel}): not read: {exc.lines[0]}")
            continue
        if state != "OPEN":
            lines.append(f"  {origin} is {state.lower()} on the forge; "
                         f"{r.rel} still records it")
    return lines


def github_inbound(args) -> int:
    need_tree()
    exe = gh_path()
    fields = ["issue", "list", "--state", "open", "--limit", str(args.limit),
              "--json", "number,title,body,url,comments"]
    if args.label:
        fields += ["--label", args.label]
    issues = gh_json(exe, fields, args.repo,
                     lambda d: isinstance(d, list) and all(map(is_issue, d)))
    # No forge call is made under the lock: what is held is the scan of
    # recorded origins through the last file written (S10-F5), so no
    # deposit, import or promotion can pass its own check on the tree this
    # one is about to change.
    with tree_lock():
        records, plan, handed = inbound_write(issues, args)
    names = ", ".join(p.stem for p, _ in plan) or "none"
    print(f"park: {len(plan)} new deposit(s) from {len(issues)} open "
          f"issue(s), {len(issues) - len(plan) - handed} already recorded"
          + (f", {handed} left on the forge with a comment "
             f"(--with-commented imports them)" if handed else "")
          + f": {names}")
    listed = {url_names(item) for item in issues}
    only = REPO_ARG.fullmatch(args.repo) if args.repo else None
    for line in gone_from_forge(exe, records, listed,
                                Repo.of(only) if only else None):
        print(line)
    return 0


def inbound_write(issues: list, args) -> tuple[list, list, int]:
    """The inbound import's check-and-insert: the recorded origins, the
    deposits planned from the issues none records, and those deposits
    written. Returns (the records, the plan, how many were left handed
    off)."""
    records = github_records()
    seen, legacy = recorded(records)
    origin_at = {r.path: r.origin for r in records}
    new = [(url_names(item), item)
           for item in sorted(issues, key=lambda i: i["number"])]
    new = [(issue, item) for issue, item in new if issue not in seen]
    # A comment marks an issue handed off (estate-issues, ruling 5): it stays
    # on the forge, and importing it would queue it a second time.
    handed = 0 if args.with_commented else sum(
        bool(item["comments"]) for _, item in new)
    if not args.with_commented:
        new = [(issue, item) for issue, item in new if not item["comments"]]
    # A 0.4.0 origin with the same number may be recording this very issue,
    # or another repository's: importing would risk a duplicate, skipping
    # would risk a loss, so neither is guessed at.
    unbound = [unbound_conflict(legacy, *issue) for issue, _ in new
               if issue[1] in legacy]
    if unbound:
        raise Refused(*unbound)
    today = datetime.date.today().isoformat()
    plan: list[tuple[Path, str]] = []
    for (repo, n), item in new:
        path = issue_deposit_path(repo, n, item["title"], origin_at)
        body = "\n".join((item["body"] or "").splitlines()).strip()
        plan.append((path, f"Deposited by park, {today}, origin "
                           f"{repo.origin(n)}\n"
                           f"{issue_line(n, item['title'])}\n\n"
                           f"{item['url']}\n"
                           + (f"\n{body}\n" if body else "")))
    made: list[Path] = []
    new_dir = not INBOX.is_dir()
    try:
        if plan:
            INBOX.mkdir(parents=True, exist_ok=True)
        for path, text in plan:
            create_file(path, text, made)
    except OSError as exc:
        left = drop_new_inbox(new_dir, rollback(made, {}))
        raise Refused(refusal("PARK-E214", f"writing the deposits failed "
                              f"({exc}); " + undone(
                                  left, "none was left behind"))) from None
    return records, plan, handed


def github_outbound(args) -> int:
    dest: Repo = args.destination
    exe = gh_path()
    errors: list[str] = []
    briefs = load_briefs(errors)
    validate(briefs, errors)
    if errors:
        raise Refused(*errors)
    todo, elsewhere, unbound = [], [], []
    for bid, b in sorted(briefs.items()):
        if b["status"] != "done":
            continue
        body = [l for l in b["_body"].splitlines() if l.strip()]
        origin = leading_origin(body[0]) if body else None
        issue = bound_origin(origin)
        if issue is not None:
            (todo if issue[0] == dest else elsewhere).append((issue, b))
        elif legacy_number(origin) is not None:
            unbound.append(refusal("PARK-E218", f"{b['_path']}: origin "
                                   f"{origin} names no repository, so its "
                                   f"issue can be closed in none; "
                                   f"{EDIT_HINT.format(n=legacy_number(origin))}"))
    if unbound:
        raise Refused(*unbound)
    planned, skipped, moved = [], [], []
    for (repo, n), b in todo:
        data = gh_json(exe, ["issue", "view", str(n), "--json",
                             "number,state,url"], args.repo, is_view)
        at = issue_url(data["url"])
        comment = (f"Closed by park: brief `{b['id']}` reached status done. "
                   f"{b['brief']}")
        # The forge's own answer is the authority, held to the brief's own
        # binding: a renamed or transferred repository, or a host `gh`
        # resolves differently, answers with another URL, and nothing is
        # closed on the strength of a guess.
        if at != (repo, n):
            moved.append((n, b["id"], at[0].origin(at[1]), repo.origin(n)))
            continue
        state = data["state"]
        (planned if state == "OPEN" else skipped).append(
            (n, b["id"], comment, state))
    print(f"park: plan — {len(planned)} issue(s) to close, {len(skipped)} "
          f"not open, {len(elsewhere) + len(moved)} not in {dest}")
    for n, bid, comment, _ in planned:
        print(f"  close #{n} (brief {bid}) with comment: {comment}")
    for n, bid, _, state in skipped:
        print(f"  skip  #{n} (brief {bid}): {state.lower()}")
    for (repo, n), b in elsewhere:
        print(f"  skip  #{n} (brief {b['id']}): bound to {repo}, not {dest}")
    for n, bid, answer, bound in moved:
        print(f"  skip  #{n} (brief {bid}): the forge answers {answer}, not "
              f"{bound}")
    if not args.apply:
        print("park: plan only; nothing was written. Re-run with --apply to "
              "make these closes.")
        return 0
    closed: list[int] = []
    for n, _, comment, _ in planned:
        try:
            gh(exe, ["issue", "close", str(n), "--reason", "completed",
                     "--comment", comment], args.repo)
        except Refused as exc:
            made = ", ".join(f"#{c}" for c in closed) or "none"
            raise Refused(refusal("PARK-E305", f"closing #{n} failed "
                                  f"({exc.lines[0]}); closed before it by "
                                  f"this run: {made}")) from None
        closed.append(n)
        print(f"  closed #{n}")
    print(f"park: applied — {len(closed)} issue(s) closed")
    return 0


def intake_github(args) -> int:
    if args.apply and not args.outbound:
        raise Refused(refusal("PARK-E001", "--apply acts only with "
                                           "--outbound"))
    if args.outbound and (args.label or args.with_commented):
        raise Refused(refusal("PARK-E001", "--label and --with-commented "
                                           "steer the inbound import only"))
    if args.outbound and args.repo is None:
        raise Refused(refusal("PARK-E001", "--outbound needs --repo "
                              "[HOST/]OWNER/NAME, the repository whose issues "
                              "it closes"))
    args.destination = None
    if args.repo is not None and args.outbound:
        m = REPO_ARG.fullmatch(args.repo)
        if m is None:
            raise Refused(refusal("PARK-E001", f"--repo {args.repo!r} is not "
                                  f"[HOST/]OWNER/NAME"))
        args.destination = Repo.of(m)
    return github_outbound(args) if args.outbound else github_inbound(args)


# -------------------------------------------------------------------- CLI

class Parser(argparse.ArgumentParser):
    """argparse, with its usage refusals carrying their code as well."""

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(2, refusal("PARK-E001", f"{self.prog}: {message}") + "\n")


def build_parser() -> Parser:
    parser = Parser(prog="park")
    parser.add_argument("--version", action="version",
                        version=f"park {PARK_VERSION}")
    sub = parser.add_subparsers(dest="verb", required=True)
    sub.add_parser("validate", help="check every brief under briefs/")
    p_map = sub.add_parser("map", help="validate, then compile TODO.md")
    p_map.add_argument("--check", action="store_true",
                       help="compare instead of writing; non-zero on drift")
    p_in = sub.add_parser("intake", help="the deposit queue, briefs/inbox/")
    verbs = p_in.add_subparsers(dest="intake", required=True)
    verbs.add_parser("list", help="every deposit and what promote's checks "
                     "say of it, and each file there that is not one")
    p_dep = verbs.add_parser("deposit", help="create briefs/inbox/ID.md from "
                             "stdin or --file; never overwrites")
    p_dep.add_argument("id")
    p_dep.add_argument("--file")
    p_pro = verbs.add_parser("promote", help="deposit -> briefs/ID.md, map "
                             "regenerated, deposit removed: all or nothing")
    p_pro.add_argument("id")
    p_pro.add_argument("--type", choices=sorted(TYPES), default="task")
    p_pro.add_argument("--trigger", action="append", metavar="TEXT")
    p_pro.add_argument("--origin", help="only for a line 1 that declares "
                       "none (the form written before 0.4.0)")
    p_rej = verbs.add_parser("reject", help="delete a deposit and print one "
                             "record line")
    p_rej.add_argument("id")
    p_rej.add_argument("--reason", required=True)
    p_gh = verbs.add_parser("github", help="open issues -> deposits; "
                            "--outbound plans the closes, --apply makes them")
    p_gh.add_argument("--repo", metavar="REPOSITORY",
                      help="[HOST/]OWNER/NAME; outbound requires it")
    p_gh.add_argument("--label", help="import only issues with this label")
    p_gh.add_argument("--limit", type=issue_limit, default=100,
                      help="import at most this many issues, 1 to 1000")
    p_gh.add_argument("--with-commented", action="store_true",
                      help="also import an open issue that has a comment")
    p_gh.add_argument("--outbound", action="store_true",
                      help="plan closing issues whose brief is done")
    p_gh.add_argument("--apply", action="store_true",
                      help="with --outbound, make those closes")
    return parser


def issue_limit(value: str) -> int:
    if not (value.isdigit() and 1 <= int(value) <= 1000):
        raise argparse.ArgumentTypeError("takes a whole number, 1 to 1000")
    return int(value)


INTAKE = {"list": intake_list, "deposit": intake_deposit,
          "promote": intake_promote, "reject": intake_reject,
          "github": intake_github}


def main(argv=None) -> int:
    try:
        return run(argv)
    except KeyboardInterrupt:
        return interrupted()


def run(argv) -> int:
    args = build_parser().parse_args(argv)
    if not ROOT.is_absolute():          # `find_root`: the directory is gone
        print(refusal("PARK-E101", "the working directory no longer exists, "
                      "so no `briefs/` can be looked for above it; change to "
                      "the repository and run again"), file=sys.stderr)
        return 1
    if args.verb == "intake":
        try:
            if args.intake == "promote":    # the index is read, then rewritten
                with tree_lock():
                    return intake_promote(args)
            return INTAKE[args.intake](args)
        except Refused as exc:
            for line in exc.lines:
                print(line, file=sys.stderr)
            return 2 if exc.lines[-1].startswith("PARK-E001") else 1

    # A reader holds it shared: mid-promote the brief exists and the index
    # does not yet name it, which `--check` would call drift.
    with tree_lock(shared=args.verb == "validate" or args.check):
        return tree_verb(args)


def tree_verb(args) -> int:
    errors: list[str] = []
    briefs = load_briefs(errors)
    validate(briefs, errors)
    if errors:
        for e in errors:
            print(e, file=sys.stderr)
        print(f"park: {len(errors)} error(s) in "
              f"{len(briefs)} parsed brief(s)", file=sys.stderr)
        return 1
    if args.verb == "validate":
        print(f"park: {len(briefs)} briefs valid")
        return 0

    try:
        current, want, head = compose_map(briefs)
    except Refused as exc:
        for line in exc.lines:
            print(line, file=sys.stderr)
        return 1
    if args.check:
        if head is None:
            print(refusal("PARK-E140", f"{TODO.name} carries no generated "
                          f"region (marker {END_MARK!r} absent) — run "
                          f"`bin/park map`"), file=sys.stderr)
            return 1
        if current != want:
            print(refusal("PARK-E141", f"{TODO.name} is stale against "
                          f"briefs/ — run `bin/park map`"), file=sys.stderr)
            return 1
        print(f"park: map current ({len(briefs)} briefs)")
        return 0
    if current == want:
        print(f"park: map already current ({len(briefs)} briefs)")
        return 0
    try:
        write_atomic(TODO, want.encode("utf-8"))
    except OSError as exc:
        print(refusal("PARK-E143", f"{TODO.name}: cannot be written "
                      f"({exc.strerror or type(exc).__name__}); it is "
                      f"unchanged"), file=sys.stderr)
        return 1
    print(f"park: map written ({len(briefs)} briefs)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
